# Copy this file to .env (gitignored) and fill in as needed.
# .env is loaded automatically by run.ps1 for scheduled runs.

# Default delivery recipient for the scheduled run (used when a profile has no
# delivery target, or for the Gmail-draft fallback). An email address, or "me".
MARKET_INTEL_TO=you@example.com

# GitHub token (optional but recommended — raises the gh rate limit from 60 to 5000/hr).
# Create at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=ghp_...
